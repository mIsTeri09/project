{
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "css/*", "use": "@vercel/static" },
    { "src": "js/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/panel.html", "dest": "/panel.html" },
    { "src": "/commands.html", "dest": "/commands.html" },
    { "src": "/logs.html", "dest": "/logs.html" },
    { "src": "/settings.html", "dest": "/settings.html" },
    { "src": "/target.html", "dest": "/target.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
